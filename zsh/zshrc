# =========================================================
# AI PROJECT CONTEXT
# =========================================================

ai-ctx() {
    local target_dir="${1:-.}"

    echo "--- PROJECT CONTEXT ---"

    if command -v eza >/dev/null 2>&1; then
        eza \
            --tree \
            --level=4 \
            --color=never \
            --icons=never \
            --git-ignore \
            "$target_dir"

    elif command -v tree >/dev/null 2>&1; then
        tree \
            -L 4 \
            -I 'node_modules|.git|.next|dist|build' \
            "$target_dir"

    else
        find "$target_dir" \
            -maxdepth 4 \
            -type f \
            | sort
    fi
}


ai-ctx-copy() {
    local target_dir="${1:-.}"

    if command -v wl-copy >/dev/null 2>&1; then
        ai-ctx "$target_dir" | wl-copy

    elif command -v xclip >/dev/null 2>&1; then
        ai-ctx "$target_dir" | xclip -selection clipboard

    else
        echo "Clipboard utility not found."
        echo "Install with:"
        echo "sudo pacman -S wl-clipboard"
        return 1
    fi

    echo "Context for '$target_dir' copied to clipboard!" >&2
}


# =========================================================
# VECTORCODE RAG
# =========================================================
# One-time setup on this laptop:
#   llm-rag-install    -> installs VectorCode with working dependencies
#   rag-db-setup       -> standalone ChromaDB server on port 8100
#
# One-time setup per project (run anywhere inside the repo):
#   llm-rag-config     -> writes .vectorcode/config.json + include list
#   llm-rag-index      -> builds the index
#
# Daily use:
#   llm-rag-query how are products fetched
#   llm-rag-index      -> re-run after big code changes
#   llm-rag-status     -> see what is indexed
#   llm-rag-reset      -> wipe + rebuild (after changing config)
#
# db_url uses port 8100 so VectorCode never collides with
# vLLM / MiniCPM, which runs on port 8000.
#
# NOTE: VectorCode can segfault on exit AFTER doing its work.
# These functions check the output, not the exit code.

# Project root = nearest folder with .vectorcode, else git root, else $PWD.
_rag_root() {
    local dir="$PWD"

    while [[ "$dir" != "/" ]]; do
        [[ -d "$dir/.vectorcode" ]] && { print -r -- "$dir"; return 0; }
        dir="${dir:h}"
    done

    git rev-parse --show-toplevel 2>/dev/null || print -r -- "$PWD"
}

# ---------------------------------------------------------
# STANDALONE CHROMADB SERVER (port 8100)
# ---------------------------------------------------------
# VectorCode's bundled database server crashes mid-indexing
# ("httpx.ConnectError: All connection attempts failed").
# A standalone ChromaDB 0.6.3 server fixes that.
# Run once:  rag-db-setup
# It then starts automatically at login (systemd user service).

_RAG_DB_URL="http://127.0.0.1:8100"
_RAG_DB_DIR="$HOME/.local/share/vectorcode/chroma-server"
_RAG_DB_UNIT="vectorcode-chroma.service"

_rag_db_up() {
    curl -fsS --max-time 2 "$_RAG_DB_URL/api/v1/heartbeat" >/dev/null 2>&1
}

rag-db-setup() {
    local chroma_bin="$HOME/.local/share/uv/tools/vectorcode/bin/chroma"

    # Prefer the chroma that ships inside VectorCode's own environment,
    # so client and server are the exact same version.
    if [[ ! -x "$chroma_bin" ]]; then
        echo "chroma not found in VectorCode's environment, installing chromadb 0.6.3..."
        uv tool install "chromadb==0.6.3" --python 3.12 || return 1
        chroma_bin=$(command -v chroma) || { echo "chroma install failed."; return 1; }
    fi

    mkdir -p "$HOME/.config/systemd/user" "$_RAG_DB_DIR"

    command cat > "$HOME/.config/systemd/user/$_RAG_DB_UNIT" <<EOF
[Unit]
Description=ChromaDB server for VectorCode (port 8100)
After=network.target

[Service]
WorkingDirectory=$_RAG_DB_DIR
Environment=ANONYMIZED_TELEMETRY=False
ExecStart=$chroma_bin run --host 127.0.0.1 --port 8100 --path $_RAG_DB_DIR
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable --now "$_RAG_DB_UNIT" || return 1

    echo -n "Waiting for ChromaDB on port 8100"
    for _ in {1..30}; do
        _rag_db_up && { echo; echo "✅ ChromaDB server is running."; return 0; }
        echo -n "."
        sleep 1
    done

    echo
    echo "❌ ChromaDB did not start. Logs:"
    journalctl --user -u "$_RAG_DB_UNIT" -n 30 --no-pager
    return 1
}

alias rag-db-status="systemctl --user status $_RAG_DB_UNIT --no-pager"
alias rag-db-restart="systemctl --user restart $_RAG_DB_UNIT"
alias rag-db-logs="journalctl --user -u $_RAG_DB_UNIT -n 50 --no-pager"

# ---------------------------------------------------------
# VECTORCODE INSTALL / REPAIR
# ---------------------------------------------------------
# tree-sitter-language-pack 1.x throws DownloadError for unknown
# languages (e.g. 'transact-sql'), which crashes VectorCode's
# indexing. 0.x bundles all parsers and works with VectorCode.
# tree-sitter 0.26 is newer than those parsers and segfaults,
# so it is pinned to 0.25.x.

llm-rag-install() {
    uv tool install --reinstall "vectorcode<1.0.0" \
        --python 3.12 \
        --with "tree-sitter-language-pack<1" \
        --with "tree-sitter>=0.25.1,<0.26" || return 1

    # The ChromaDB service runs from VectorCode's environment.
    systemctl --user restart "$_RAG_DB_UNIT" 2>/dev/null

    echo
    echo "✅ VectorCode installed: $(vectorcode version 2>/dev/null)"
    echo "   tree-sitter-language-pack: $(_rag_tslp_version)"
    echo "   tree-sitter: $(_rag_pkg_version tree-sitter)"
}

_rag_pkg_version() {
    "$HOME/.local/share/uv/tools/vectorcode/bin/python" -c \
        "import importlib.metadata as m; print(m.version('$1'))" \
        2>/dev/null
}

_rag_tslp_version() {
    "$HOME/.local/share/uv/tools/vectorcode/bin/python" -c \
        "import importlib.metadata as m; print(m.version('tree-sitter-language-pack'))" \
        2>/dev/null
}

_rag_check() {
    if ! command -v vectorcode >/dev/null 2>&1; then
        echo "VectorCode is not installed."
        echo "Install: uv tool install \"vectorcode<1.0.0\" --python 3.12"
        return 1
    fi

    if ! curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        echo "Ollama is not running. Run: ai-on"
        return 1
    fi

    local tslp
    tslp=$(_rag_tslp_version)
    if [[ "$tslp" == <1->.* ]]; then
        echo "tree-sitter-language-pack $tslp breaks VectorCode indexing."
        echo "Run once: llm-rag-install"
        return 1
    fi

    local ts
    ts=$(_rag_pkg_version tree-sitter)
    if [[ "$ts" == 0.<26->.* || "$ts" == <1->.* ]]; then
        echo "Note: tree-sitter $ts may crash VectorCode. Fix: llm-rag-install"
    fi

    if ! _rag_db_up; then
        if systemctl --user cat "$_RAG_DB_UNIT" >/dev/null 2>&1; then
            echo "Starting ChromaDB server..."
            systemctl --user start "$_RAG_DB_UNIT"
            for _ in {1..20}; do _rag_db_up && break; sleep 1; done
        fi

        if ! _rag_db_up; then
            echo "ChromaDB server is not running on port 8100."
            echo "Run once: rag-db-setup   (logs: rag-db-logs)"
            return 1
        fi
    fi
}


# =========================================================
# VECTORCODE RAG CONFIGURATION
# =========================================================

llm-rag-config() {
    local root include_file dir
    root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    include_file="$root/.vectorcode/vectorcode.include"

    mkdir -p "$root/.vectorcode"

    command cat > "$root/.vectorcode/config.json" <<'EOF'
{
  "embedding_function": "OllamaEmbeddingFunction",
  "embedding_params": {
    "url": "http://127.0.0.1:11434/api/embeddings",
    "model_name": "nomic-embed-text:latest"
  },
  "db_url": "http://127.0.0.1:8100"
}
EOF

    # Never index generated code, migrations, lockfiles or build output.
    command cat > "$root/.vectorcode/vectorcode.exclude" <<'EOF'
prisma/migrations/**
**/generated/**
node_modules/**
.next/**
dist/**
build/**
coverage/**
public/**
*.lock
package-lock.json
pnpm-lock.yaml
*.min.js
*.map
*.ico
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.bmp
*.svg
*.woff
*.woff2
*.ttf
*.otf
*.eot
*.pdf
*.zip
*.gz
*.mp3
*.mp4
*.webm
*.wav
*.db
*.sqlite
EOF

    # Include list built from the source folders that actually exist.
    : > "$include_file"

    for dir in src app pages components lib hooks utils types services \
               server api actions prisma db styles config scripts; do
        [[ -d "$root/$dir" ]] && echo "$dir/**" >> "$include_file"
    done

    echo "*.md" >> "$include_file"

    if command -v ollama >/dev/null 2>&1 && \
       ! ollama list 2>/dev/null | command grep -q '^nomic-embed-text'; then
        echo "Pulling embedding model nomic-embed-text..."
        ollama pull nomic-embed-text
    fi

    echo "VectorCode config created:"
    echo "  $root/.vectorcode/config.json"
    echo "Folders to index (edit $include_file if needed):"
    sed 's/^/  /' "$include_file"
    echo
    echo "Next: llm-rag-index"
}


# =========================================================
# VECTORCODE INDEX
# =========================================================
# llm-rag-index            -> index everything in vectorcode.include
# llm-rag-index app lib    -> index only the given folders

llm-rag-index() {
    _rag_check || return 1

    local root count
    root=$(_rag_root)

    if [[ $# -eq 0 ]]; then
        if [[ ! -f "$root/.vectorcode/vectorcode.include" ]]; then
            echo "No .vectorcode/vectorcode.include in $root"
            echo "Run llm-rag-config first, or: llm-rag-index <dir> [dir ...]"
            return 1
        fi

        echo "Indexing $root (folders from vectorcode.include)..."
        ( cd "$root" && VECTORCODE_LOG_LEVEL=WARNING vectorcode --project_root "$root" vectorise )
    else
        echo "Indexing: $*"
        ( cd "$root" && VECTORCODE_LOG_LEVEL=WARNING vectorcode --project_root "$root" vectorise -r "$@" )
    fi

    local vc_exit=$?

    # A crash (signal) means tree-sitter died on some file.
    # Re-run with chunk_size=-1: VectorCode then stores each file whole
    # and never calls tree-sitter. Files already indexed are skipped.
    if [[ $vc_exit -ge 128 ]]; then
        echo
        echo "⚠️  vectorcode crashed (signal $((vc_exit - 128))). Retrying without tree-sitter..."

        if [[ $# -eq 0 ]]; then
            ( cd "$root" && VECTORCODE_LOG_LEVEL=WARNING vectorcode --project_root "$root" vectorise --chunk_size=-1 )
        else
            ( cd "$root" && VECTORCODE_LOG_LEVEL=WARNING vectorcode --project_root "$root" vectorise --chunk_size=-1 -r "$@" )
        fi

        vc_exit=$?
    fi

    if [[ $vc_exit -ne 0 ]]; then
        echo
        if [[ $vc_exit -ge 128 ]]; then
            echo "⚠️  vectorcode crashed (signal $((vc_exit - 128)), exit $vc_exit)."
        else
            echo "⚠️  vectorcode exited with code $vc_exit."
        fi
        local vc_logs=(~/.local/share/vectorcode/logs/*.log(Nom))
        echo "   Latest log: ${vc_logs[1]:-none found}"
    fi

    count=$(cd "$root" && vectorcode --project_root "$root" files ls 2>/dev/null | command grep -c .)

    echo
    if [[ "$count" -gt 0 ]]; then
        echo "✅ Files in index: $count"
    else
        echo "❌ Index is empty. Check the folders in $root/.vectorcode/vectorcode.include"
        return 1
    fi
}


# =========================================================
# VECTORCODE RESET
# =========================================================
# Use after changing embedding model / config.

llm-rag-reset() {
    _rag_check || return 1

    local root
    root=$(_rag_root)

    ( cd "$root" && vectorcode --project_root "$root" drop ) >/dev/null 2>&1
    llm-rag-index
}



# =========================================================
# OLLAMA SYSTEMD OPTIMIZATION
# =========================================================
# Ollama is managed by systemd, so server-side variables belong
# in the systemd service rather than only in .zshrc.

ai-optimize-service() {
    sudo mkdir -p /etc/systemd/system/ollama.service.d || return 1

    sudo tee /etc/systemd/system/ollama.service.d/override.conf >/dev/null <<'EOF'
[Service]
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=2"
Environment="OLLAMA_CONTEXT_LENGTH=16384"
Environment="OLLAMA_KEEP_ALIVE=1h"
EOF

    sudo systemctl daemon-reload || return 1
    sudo systemctl restart ollama || return 1

    echo
    echo "Ollama service optimization applied."
    echo
    echo "Verify with:"
    echo "systemctl show ollama -p Environment"
}



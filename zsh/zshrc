# =========================================================
# VECTORCODE HYBRID RAG
# =========================================================

llm-rag-query() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: llm-rag-query <question>"
        return 1
    fi

    _rag_check || return 1

    local query="$*"
    local root context_file rg_files word file exit_code
    local rg_ignore=(
        --hidden
        --glob '!.git/**'
        --glob '!node_modules/**'
        --glob '!.next/**'
        --glob '!dist/**'
        --glob '!build/**'
        --glob '!.agents/**'
        --glob '!.agent_context/**'
        --glob '!.vectorcode/**'
        --glob '!*.lock'
        --glob '!package-lock.json'
        --glob '!public/**'
    )

    # Max characters of context sent to Qwen (~10k tokens),
    # so it fits in Ollama's 16k context and the question isn't cut off.
    local max_chars=40000

    root=$(_rag_root)
    context_file=$(mktemp)

    echo "============================================================"
    echo "HYBRID RAG"
    echo "============================================================"
    echo "Project: $root"
    echo "Query:   $query"
    echo

    # ---------------------------------------------------------
    # [1/3] EXACT SEARCH (rg)
    # ---------------------------------------------------------

    echo "[1/3] Searching exact code matches with rg..."

    rg_files=$(cd "$root" && rg -l -F -i "${rg_ignore[@]}" -- "$query" . 2>/dev/null | head -10)

    if [[ -z "$rg_files" ]]; then
        for word in ${(s: :)query}; do
            word="${word//[^a-zA-Z0-9_-]/}"
            [[ ${#word} -lt 3 ]] && continue

            case "${word:l}" in
                what|the|this|project|about|how|does|work|works|why|where|which|are|was|and|for|with|from|that|into|have|use|used|uses)
                    continue
                    ;;
            esac

            (cd "$root" && rg -l -F -i "${rg_ignore[@]}" -- "$word" . 2>/dev/null | head -5)
        done | sort -u | head -10 > "${context_file}.rg"
    else
        print -r -- "$rg_files" > "${context_file}.rg"
    fi

    if [[ -s "${context_file}.rg" ]]; then
        echo "Found $(wc -l < "${context_file}.rg" | tr -d ' ') matching files."
    else
        echo "No exact matches found."
    fi
    echo

    # ---------------------------------------------------------
    # [2/3] SEMANTIC SEARCH (VectorCode)
    # ---------------------------------------------------------

    echo "[2/3] Searching semantic matches with VectorCode..."

    # Chunks (not whole files) keep context small and relevant.
    (cd "$root" && vectorcode \
        --project_root "$root" \
        --no_stderr \
        query \
        --include path chunk \
        -n 12 \
        "$query") > "${context_file}.vector" 2>/dev/null

    # Only count it as context if real results came back (they start with "Path:").
    if command grep -q '^Path:' "${context_file}.vector" 2>/dev/null; then
        echo "VectorCode returned $(command grep -c '^Path:' "${context_file}.vector") matches."
    else
        if [[ -s "${context_file}.vector" ]]; then
            echo "VectorCode returned no results. Its output was:"
            head -5 "${context_file}.vector" | sed 's/^/  /'
        else
            echo "VectorCode returned no results."
        fi
        echo "  Index empty? Run: llm-rag-index"
        : > "${context_file}.vector"
    fi
    echo

    # ---------------------------------------------------------
    # BUILD CONTEXT
    # ---------------------------------------------------------

    {
        echo "PROJECT: ${root:t}"
        echo

        for file in AGENTS.md .agent_context.md package.json; do
            [[ -f "$root/$file" ]] || continue
            echo "===== PROJECT FILE: $file ====="
            head -c 6000 "$root/$file"
            echo
            echo
        done

        if [[ -s "${context_file}.vector" ]]; then
            echo "===== SEMANTIC MATCHES (VectorCode) ====="
            command cat "${context_file}.vector"
            echo
        fi

        if [[ -s "${context_file}.rg" ]]; then
            echo "===== EXACT MATCHES (rg) ====="
            echo

            while IFS= read -r file; do
                [[ -f "$root/$file" ]] || continue
                echo "----- ${file#./} -----"

                for word in "$query" ${(s: :)query}; do
                    word="${word//[^a-zA-Z0-9_ -]/}"
                    [[ ${#word} -lt 3 ]] && continue
                    rg -n -i -F -C 3 -- "$word" "$root/$file" 2>/dev/null | head -40
                done | awk '!seen[$0]++' | head -60

                echo
            done < "${context_file}.rg"
        fi
    } | head -c "$max_chars" > "$context_file"

    # ---------------------------------------------------------
    # [3/3] QWEN
    # ---------------------------------------------------------

    echo "[3/3] Qwen is analyzing the combined context..."
    echo

    local render=(command cat)
    command -v glow >/dev/null 2>&1 && render=(glow -)

    {
        command cat <<EOF
You are a coding assistant analyzing an existing software project.
Answer the user's question using ONLY the retrieved project context below.

Rules:
- The user is asking about existing code. Do not propose changes unless asked.
- Do not invent files, functions, imports, APIs, or behavior.
- Mention exact file paths.
- For "where" questions, list the relevant files.
- For "how" questions, trace the implementation step by step.
- If the context is not enough, say so instead of guessing.

RETRIEVED PROJECT CONTEXT:
EOF
        command cat "$context_file"
        echo
        echo
        echo "USER QUESTION: $query"
        echo "Answer using only the context above."
    } | ollama run "${AI_MODEL:-qwen2.5-agent}" \
      | perl -pe 's/\e\[[0-9;?]*[ -\/]*[@-~]//g' \
      | "${render[@]}"

    exit_code=${pipestatus[2]}

    rm -f "$context_file" "${context_file}.rg" "${context_file}.vector"

    return $exit_code
}



# =========================================================
# AUTOMATIC PROJECT CONTEXT — UA
# =========================================================
# Usage:
#   cd ~/your-project
#   ua
#
# ua is the ONLY command needed.
# It bootstraps its own helper script automatically.
# It respects the existing ai-on / ai-off switch.
# =========================================================

ua() {
    local root context_dir context_file fingerprint_file lock_dir
    local tmp prompt output model

    root=$(git rev-parse --show-toplevel 2>/dev/null)

    if [[ -z "$root" ]]; then
        echo "❌ Not inside a Git repository."
        return 1
    fi

    # Your existing ai-on / ai-off aliases are the master switch.
    # ua NEVER starts or stops Ollama.
    if ! systemctl is-active --quiet ollama 2>/dev/null; then
        echo "🔒 AI is OFF — run ai-on first."
        return 0
    fi

    root="$(cd "$root" && pwd)"
    context_dir="$root/.agent_context"
    context_file="$root/.agent_context.md"
    fingerprint_file="$context_dir/.fingerprint"
    lock_dir="$context_dir/.lock"

    mkdir -p "$context_dir"

    if ! mkdir "$lock_dir" 2>/dev/null; then
        echo "⏳ Project context update already running."
        return 0
    fi

    cleanup_ua() {
        rm -f "$tmp" "$prompt" "$output"
        rmdir "$lock_dir" 2>/dev/null || true
    }
    trap cleanup_ua EXIT

    echo "🔎 Checking project: $(basename "$root")"

    fingerprint="$(
        {
            git rev-parse HEAD 2>/dev/null || true
            git status --porcelain 2>/dev/null || true

            find . -maxdepth 4 -type f \
                \( -name 'package.json' -o \
                   -name 'pnpm-lock.yaml' -o \
                   -name 'package-lock.json' -o \
                   -name 'yarn.lock' -o \
                   -name 'bun.lock' -o \
                   -name 'bun.lockb' -o \
                   -name 'tsconfig.json' -o \
                   -name 'next.config.*' -o \
                   -name 'vite.config.*' -o \
                   -name 'astro.config.*' -o \
                   -name 'nuxt.config.*' -o \
                   -name 'svelte.config.*' -o \
                   -path './prisma/schema.prisma' -o \
                   -name 'AGENTS.md' -o \
                   -name 'README.md' -o \
                   -name '.env.example' -o \
                   -name 'docker-compose.yml' -o \
                   -name 'compose.yml' \) \
                -not -path './.git/*' \
                -not -path './node_modules/*' \
                -not -path './.next/*' \
                -not -path './dist/*' \
                -not -path './build/*' \
                -not -path './coverage/*' \
                -print0 2>/dev/null \
            | sort -z | xargs -0r sha256sum

            find . -maxdepth 4 -type f \
                \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' \
                   -o -name '*.mjs' -o -name '*.cjs' -o -name '*.py' \
                   -o -name '*.go' -o -name '*.rs' -o -name '*.java' \) \
                -not -path './.git/*' \
                -not -path './node_modules/*' \
                -not -path './.next/*' \
                -not -path './dist/*' \
                -not -path './build/*' \
                -not -path './coverage/*' \
                -print 2>/dev/null | sort
        } | sha256sum | awk '{print $1}'
    )"

    if [[ -f "$fingerprint_file" ]] &&
       [[ "$(cat "$fingerprint_file")" == "$fingerprint" ]] &&
       [[ -f "$context_file" ]]; then
        echo "✅ Project context is already up to date."
        return 0
    fi

    echo "🧠 Analyzing project with local LLM..."

    # Make sure the already-enabled Ollama service is responding.
    for _ in {1..10}; do
        curl -fsS --max-time 1 \
            http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
        sleep 0.5
    done

    if ! curl -fsS --max-time 1 \
        http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        echo "❌ Ollama is enabled but not responding."
        return 1
    fi

    tmp="$context_dir/context.$$.tmp"
    prompt="$context_dir/context.$$.prompt"
    output="$context_dir/context.$$.output"

    {
        echo "# PROJECT FACTS"
        echo
        echo "Project: $(basename "$root")"
        echo "Path: $root"
        echo

        echo "## Git"
        git branch --show-current 2>/dev/null || true
        git log -5 --oneline --decorate 2>/dev/null || true
        echo
        git status --short 2>/dev/null || true
        echo
        git diff --stat HEAD 2>/dev/null || true

        echo
        echo "## Project Tree"
        if command -v eza >/dev/null 2>&1; then
            eza --tree --level=3 --color=never --icons=never --git-ignore \
                --ignore-glob='.git|node_modules|.next|dist|build|coverage|.cache' . \
                2>/dev/null || true
        elif command -v tree >/dev/null 2>&1; then
            tree -L 3 \
                -I 'node_modules|.git|.next|dist|build|coverage|.cache' . \
                2>/dev/null || true
        else
            find . -maxdepth 3 -type f \
                -not -path './.git/*' \
                -not -path './node_modules/*' \
                -not -path './.next/*' \
                -not -path './dist/*' \
                -not -path './build/*' \
                -not -path './coverage/*' \
                | sort | head -500
        fi

        echo
        echo "## Important Project Files"
        for file in \
            README.md AGENTS.md package.json tsconfig.json \
            next.config.ts next.config.js next.config.mjs \
            vite.config.ts prisma/schema.prisma .env.example \
            docker-compose.yml compose.yml
        do
            if [[ -f "$file" ]]; then
                echo
                echo "===== $file ====="
                sed -n '1,350p' "$file"
            fi
        done

        echo
        echo "## Source File Inventory"
        find . -maxdepth 4 -type f \
            \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' \
               -o -name '*.mjs' -o -name '*.cjs' -o -name '*.py' \
               -o -name '*.go' -o -name '*.rs' -o -name '*.java' \) \
            -not -path './.git/*' \
            -not -path './node_modules/*' \
            -not -path './.next/*' \
            -not -path './dist/*' \
            -not -path './build/*' \
            -not -path './coverage/*' \
            | sort | head -1000
    } > "$tmp"

    model="${AI_MODEL:-qwen2.5-agent}"

    cat > "$prompt" <<'EOF'
You are maintaining a concise architectural context file for an existing software project.

Analyze the PROJECT FACTS below and write a high-level project context document.

Rules:
- Use only information supported by the supplied facts.
- Explain what the project is and what it appears to do.
- Identify the actual technology stack.
- Describe the architecture and important directories.
- Identify application entry points, routes, APIs, components, services, and database models when evident.
- Describe authentication, data access, integrations, and deployment configuration when evident.
- Mention development commands from package.json when available.
- Mention meaningful recent Git changes.
- Identify conventions actually visible in the project.
- Say "Not determined from scan" when something cannot be established.
- Keep it concise, approximately 80-150 lines.
- Do not invent features.
- Do not expose secrets or .env contents.
- Do not reproduce large source files.

Use exactly these headings:

# Project Context
## What This Project Is
## Technology Stack
## Architecture
## Important Directories
## Application Entry Points
## Routes and APIs
## Components and Services
## Database and Data Layer
## Authentication and Authorization
## External Integrations
## Development Commands
## Recent Changes
## Project Conventions
## Important Files
## Notes / Unknowns

PROJECT FACTS:
EOF

    cat "$tmp" >> "$prompt"

    echo "   → Model: $model"

    if ! ollama run "$model" < "$prompt" > "$output" 2>/dev/null; then
        echo "❌ Ollama analysis failed."
        return 1
    fi

    if [[ ! -s "$output" ]]; then
        echo "❌ Ollama returned an empty result."
        return 1
    fi

    {
        echo "<!-- AUTO-GENERATED BY ua. Do not edit manually. -->"
        echo "<!-- Generated: $(date '+%Y-%m-%d %H:%M:%S %z') -->"
        echo
        cat "$output"
    } > "$context_file"

    printf '%s\n' "$fingerprint" > "$fingerprint_file"

    echo "✅ Project understood."
    echo "✅ Updated: $context_file"

}


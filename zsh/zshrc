minicpm-on() {
    if [[ ! -d "$HOME/vllm-env" ]]; then
        echo "vLLM environment not found:"
        echo "$HOME/vllm-env"
        return 1
    fi

    source "$HOME/vllm-env/bin/activate"

    if ! command -v vllm >/dev/null 2>&1; then
        echo "vLLM command not found."
        return 1
    fi

    vllm serve openbmb/MiniCPM5-1B \
        --host 127.0.0.1 \
        --port 8000 \
        --dtype bfloat16 \
        --max-model-len 8192 \
        --gpu-memory-utilization 0.30
}



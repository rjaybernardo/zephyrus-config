// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-at-startup "noctalia"
    // Wait (max 30 s) for Noctalia's tray, otherwise ROG Control Center
    // starts without a tray icon or asusd connection.
    spawn-sh-at-startup "for i in $(seq 30); do busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1 && break; sleep 1; done; exec rog-control-center"

[Unit]
Description=PostgreSQL (user instance, data in ~/.local/share/postgresql/data)
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/postgres -D %h/.local/share/postgresql/data
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutSec=120
Restart=on-failure

[Install]
WantedBy=default.target
